# Template only — Next.js never reads `.env.example`. Copy to `.env.local`, then restart `npm run dev`.
#
# ─── Production-ish hosts (recommended for go-live) ─────────────────────────────
# Canonical HTTPS origin — sets metadataBase / Open Graph URLs. Omit on localhost unless testing OG.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
# If you serve lockups/stills from Remote `next/image`, set hostname only (no protocol/path).
# Matches `remotePatterns.hostname` in `next.config.ts`. Leave blank if all imagery is local.
NEXT_PUBLIC_IMAGE_HOST=
#
# ─── Contact ───────────────────────────────────────────────────────────────────
# WhatsApp: digits only. wa.me prefers country codes (India: 9198…). Avoid ambiguous 10-digit US lines
# that start with 6–9 — `constants/contact.ts` auto-prefixes those with `91`.
NEXT_PUBLIC_WHATSAPP_PHONE=91XXXXXXXXXX
# Optional custom prefill for wa.me
NEXT_PUBLIC_WHATSAPP_PREFILL_MESSAGE=
# Dedicated voice line (falls back to WhatsApp digits for tel:) — omit to reuse WhatsApp number
NEXT_PUBLIC_VOICE_PHONE=
# Fallback mail composer when webhook is unreachable (shown in browser — do not treat as secret)
NEXT_PUBLIC_ENQUIRY_EMAIL=
#
# ─── Lead capture (Apps Script webhook) ───────────────────────────────────────
# Prefer `ENQUIRY_SCRIPT_URL` on the server (Vercel etc.) — it never ships in the JS bundle.
# You may mirror with `NEXT_PUBLIC_ENQUIRY_SCRIPT_URL` for client-side checks only; omit in prod hardening if not needed.
ENQUIRY_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
NEXT_PUBLIC_ENQUIRY_SCRIPT_URL=
#
# ─── Brand / partner skins ─────────────────────────────────────────────────────
# `none` = text-only masthead. Remote URLs usually need NEXT_PUBLIC_IMAGE_HOST (see above).
NEXT_PUBLIC_PARTNER_LOGO_SRC=
NEXT_PUBLIC_PARTNER_CORP_MARK_SRC=
# Comma-separated public paths (/media/partner/foo.webp, …) overriding cinematic hero grid
NEXT_PUBLIC_PARTNER_LIFESTYLE_GALLERY_WEBPS=
# Footer “reference campaign site” link (omit tracking params)
NEXT_PUBLIC_PARTNER_REFERENCE_URL=
#
# ─── Project documents (#documents tiles) ───────────────────────────────────────
# Direct HTTPS or same-site path ending in `.pdf` enables “Download PDF”. File must exist under `public/…` when using /documents/….
# e.g. /documents/your-team-brochure.pdf — must live under `public/documents/` with that filename
NEXT_PUBLIC_DOC_BROCHURE_PDF=
NEXT_PUBLIC_DOC_COST_SHEET_PDF=
NEXT_PUBLIC_DOC_MASTER_PLAN_PDF=
#
# ─── Township video ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_TOWNSHIP_FLYTHROUGH_SRC=
# Cloudinary hint: HTTPS delivery URL ending in `.mov` → code may normalise MP4-capable playback.
