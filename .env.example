# Template only — Next.js never reads `.env.example`. Copy values into `.env.local`, then restart `npm run dev`.
#
# WhatsApp: digits only; wa.me needs country code (e.g. 91XXXXXXXXXX). Ten-digit Indian mobiles 6–9 are auto-prefixed with 91 in `constants/contact.ts`.
NEXT_PUBLIC_WHATSAPP_PHONE=7325897687
# Optional custom prefill for wa.me
NEXT_PUBLIC_WHATSAPP_PREFILL_MESSAGE="Hello - I'd like to enquire about Prestige Kollur (Velimela / Tellapur–Kollur, Hyderabad). Please share the next thoughtful step"
# Optional dedicated voice line (falls back to WhatsApp digits for tel:)
NEXT_PUBLIC_VOICE_PHONE=
# Google Apps Script web app URL — POST JSON { name, phone, interest, message, source } (preferred; server-only)
ENQUIRY_SCRIPT_URL=https://script.google.com/macros/s/AKfycbyrzL72Jl-EC8TRrWqYSercinljBJVMJB5hfNZWk4KoBWorfwmghctvEfgCY4Sh1F_GeA/exec
# Optional: same URL; when set it is also exposed in the client bundle
NEXT_PUBLIC_ENQUIRY_SCRIPT_URL=https://script.google.com/macros/s/AKfycbyrzL72Jl-EC8TRrWqYSercinljBJVMJB5hfNZWk4KoBWorfwmghctvEfgCY4Sh1F_GeA/exec
# Fallback mail composer when the script URL is unset (form receives 503 from /api/enquiry)
NEXT_PUBLIC_ENQUIRY_EMAIL=
# Optional: override project header lockup (`none` = text-only masthead). Defaults to vendored /partners/prestige-golden-grove-logo.webp from prestigegoldengrove.live.
NEXT_PUBLIC_PARTNER_LOGO_SRC=
# Optional: Prestige Group strip in channel row (`none` to hide). Defaults to /partners/prestige-group-mark.webp.
NEXT_PUBLIC_PARTNER_CORP_MARK_SRC=
# Optional: comma-separated public paths (/media/partner/foo.webp,...) overriding the lifestyle/cinematic hero grid (mirror legacy site stills here)
NEXT_PUBLIC_PARTNER_LIFESTYLE_GALLERY_WEBPS=
# Optional: brochure / cost sheet / master plan — direct PDF only enables one-tap "Download PDF" in Project documents (#documents).
# Host files under public/documents/ (e.g. public/documents/prestige-golden-grove-brochure.pdf) and reference them by site path:
#   NEXT_PUBLIC_DOC_BROCHURE_PDF=/documents/pggv-brochure.pdf
# Or use any HTTPS URL whose path ends in .pdf (CDN / Prestige-hosted file).
# When unset, tiles open the concierge modal instead.
NEXT_PUBLIC_DOC_BROCHURE_PDF=
NEXT_PUBLIC_DOC_COST_SHEET_PDF=
NEXT_PUBLIC_DOC_MASTER_PLAN_PDF=
# Township fly-through video — HTTPS MP4/WebM/MOV URL or omit to use public/media/township/flythrough.mp4
# Cloudinary: paste your delivery URL; code adds on-the-fly f_mp4 delivery for broad browser support.
# NEXT_PUBLIC_TOWNSHIP_FLYTHROUGH_SRC=https://res.cloudinary.com/<cloud>/video/upload/v123/your_asset.mov
NEXT_PUBLIC_TOWNSHIP_FLYTHROUGH_SRC=
# Optional: reference landing (campaign site) — footer link “Reference campaign site”
# Example (strip tracking params): https://prestigekollur.premiumresidency.site/
NEXT_PUBLIC_PARTNER_REFERENCE_URL=
